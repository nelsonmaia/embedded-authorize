# Copy to .env. Everything here is optional in development and read by both the dev server and
# `node server.js`; .env itself is gitignored.
#
# There is nothing secret in this file, and that is on purpose. The tenant proxy adds no
# credentials of its own — it forwards what the console sends, and refuses a client_secret. The
# Jira connection registers its own OAuth client and holds a per-browser token, so it needs no
# configuration at all.

# The AUTH0 TENANT hosts the proxy may reach, comma separated, exact hosts. Not this app's own
# URL — the server never needs to know its own address. A custom Auth0 domain goes here instead of
# the .auth0.com one if that is what the console calls. A full URL is accepted and reduced to its
# hostname, so https://your-tenant.auth0.com/ works too.
#
# REQUIRED when deploying. `node server.js` runs the proxy in strict mode and forwards nothing
# until this is set. In development it is optional: the dev server also accepts any *.auth0.com,
# *.auth0lab.com or *.authok.cn host, which is safe when it is bound to localhost and is not once
# anyone else can reach it. See scripts/tenant-proxy/forward.js.
PLAYGROUND_ALLOWED_HOSTS=your-tenant.auth0.com

# Tenant calls allowed per minute per client address. Deployment only. Default 60.
# TENANT_RATE_LIMIT=60

# Port for `node server.js`. Default 8080. The dev server is always :5177.
# PORT=8080
