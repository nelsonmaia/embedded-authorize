# Copy to .env. Everything here is optional in development and read by both the dev server and
# `node server.js`; .env itself is gitignored.
#
# There is nothing secret in this file, and that is on purpose. The tenant proxy adds no
# credentials of its own — it forwards what the console sends, and refuses a client_secret. The
# Jira connection registers its own OAuth client and holds a per-browser token, so it needs no
# configuration at all.

# There is no tenant allowlist to configure. The proxy forwards to whatever tenant the person using
# the console types, in development and deployed alike, so anyone who opens it can point it at
# their own. See scripts/tenant-proxy/forward.js for what does still bound it.

# Tenant calls allowed per minute per client address. Deployment only. Default 60.
# TENANT_RATE_LIMIT=60

# Port for `node server.js`. Default 8080. The dev server is always :5177.
# PORT=8080
